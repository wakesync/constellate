APP_URL=http://localhost:3400
PORT=3400
DB_PATH=data/constellate.sqlite
# Generate a unique secret, at least 32 characters. Never commit the actual value.
BETTER_AUTH_SECRET=
# Inference API key, NOT the Tinfoil container management admin key.
TINFOIL_API_KEY=
# Choose a currently available Tinfoil chat model. No unverified default.
TINFOIL_MODEL=

# Optional: remote Membrane (exact share/read/revoke). Leave unset to keep circle sharing fail-closed (503).
MEMBRANE_ORIGIN=
# Public Tinfoil config repo the enclave is measured against.
MEMBRANE_CONFIG_REPO=
# Shared HMAC secret, server-side only, >=16 chars.
MEMBRANE_SWARM_SECRET=
MEMBRANE_NAMESPACE=cst

# Optional: public lane (router: daily transits, sign overviews). Zero personal data.
# Unset = deterministic non-AI template. Never used for readings, chats or memory.
DARKBLOOM_API_KEY=
# A model id from GET https://api.darkbloom.dev/v1/models
DARKBLOOM_MODEL=
