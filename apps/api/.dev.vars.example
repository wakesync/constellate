# Copy to .dev.vars (gitignored) for local `wrangler dev`.
# These mirror the prod secrets set via `wrangler secret put` (see README.md).

# Shared bearer token the API uses to call the astro sidecar.
ASTRO_BEARER=dev-astro-bearer-change-me

# Attested inference only. Missing keys yield marked non-AI fallback copy.
TINFOIL_API_KEY=
TINFOIL_MODEL=

# Optional local overrides (defaults come from wrangler.toml [vars]):
# RP_ID=localhost
# RP_NAME=Constellate (dev)
# APP_ORIGIN=http://localhost:5173
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ASTRO_URL=http://127.0.0.1:8000

# Optional public lane (GET /public/sky/today only, zero personal data).
# Unset = deterministic non-AI template. Never used for readings, synastry or circle agents.
DARKBLOOM_API_KEY=
DARKBLOOM_MODEL=
